itude'),\n          e('div', { style: { height: 6, background: acc, transformOrigin: 'left', animation: 'praLine .7s cubic-bezier(.6,0,.2,1) .9s both' } }))),\n      e('div', { style: { fontFamily: \"'IBM Plex Mono',monospace\", fontSize: 13, letterSpacing: '.18em', textTransform: 'uppercase', color: 'oklch(0.78 0.01 85)', animation: 'praFade .6s ease-out 1.4s both' } }, tag));\n  }\n  componentWillUnmount() { clearTimeout(this._it); window.removeEventListener('hashchange', this._h); }\n  pageFromHash() { const p = (location.hash || '').slice(1); return ['materiel', 'tarifs', 'faq', 'contact'].includes(p) ? p : 'home'; }\n  setLang(l) { localStorage.setItem('pra_lang', l); this.setState({ lang: l, langOpen: false }); }\n  renderVals() {\n    const s = this.state, t = I18N[s.lang] || I18N.fr;\n    const loc = { fr: 'fr-FR', en: 'en-GB', es: 'es-ES', ca: 'ca-ES' }[s.lang];\n    const dec = s.lang === 'en' ? '.' : ',';\n    const setF = k => e => { const v = e.target.value; this.setState(st => ({ form: { ...st.form, [k]: v } })); };\n    const names = { fr: 'Français', en: 'English', es: 'Español', ca: 'Català' };\n    return {\n      intro: this.introEl(),\n      pg: { home: s.page === 'home', methode: s.page === 'methode', materiel: s.page === 'materiel', tarifs: s.page === 'tarifs', faq: s.page === 'faq', contact: s.page === 'contact' },\n      nav: [['materiel', NAV2[s.lang].gear], ['tarifs', t.navPricing], ['faq', 'FAQ'], ['contact', NAV2[s.lang].contact]].map(([k, label]) => ({ href: '#' + k, label,\n        style: `color:oklch(0.22 0.012 60);text-decoration:none;padding-bottom:3px;border-bottom:1px solid ${'transparent'}` })),\n      elite: { ...ELITE[s.lang], stats: ELITE[s.lang].stats.map((st, i) => ({ ...st, slot: ['elite-cyclisme', 'elite-course', 'elite-trail'][i], ph: ['Photo — cycliste en montée', 'Photo — coureur sur piste ou route', 'Photo — traileur en montée'][i], img: ['https://images.pexels.com/photos/17239244/pexels-photo-17239244.jpeg?auto=compress&cs=tinysrgb&w=1200', 'https://images.pexels.com/photos/5687440/pexels-photo-5687440.jpeg?auto=compress&cs=tinysrgb&w=1200', 'https://images.pexels.com/photos/30932860/pexels-photo-30932860.jpeg?auto=compress&cs=tinysrgb&w=1200'][i] })) },\n      depositNote: DEP[s.lang],\n      alt: s.alt, altLabel: s.alt.toLocaleString(loc) + ' m', o2Label: (20.9 * Math.exp(-s.alt / 8434)).toFixed(1).replace('.', dec) + ' %',\n      altRef: s.alt < 1500 ? SEA[s.lang] : t.refs[[1500, 2000, 2500, 3000, 4000].filter(x => s.alt >= x).length - 1],\n      onAlt: e => this.setState({ alt: +e.target.value }),\n      t, langCode: s.lang.toUpperCase(), langOpen: s.langOpen,\n      toggleLang: () => this.setState({ langOpen: !s.langOpen }),\n      langs: Object.keys(names).map(k => ({ code: k.toUpperCase(), name: names[k], pick: () => this.setLang(k),\n        style: `display:flex;justify-content:space-between;align-items:center;gap:16px;padding:10px 12px;border:0;border-radius:6px;cursor:pointer;text-align:left;font-size:14px;color:oklch(0.22 0.012 60);background:${k === s.lang ? 'oklch(0.94 0.012 85)' : 'transparent'};font-weight:${k === s.lang ? 600 : 400}` })),\n      levels: [1500, 2000, 2500, 3000, 4000].map((a, i) => ({ alt: a.toLocaleString(loc) + ' m', o2: (20.9 * Math.exp(-a / 8434)).toFixed(1).replace('.', dec) + ' %', ref: t.refs[i] })),\n      faq: t.faq.map(([q, a], i) => ({ q, a, open: s.faqOpen === i, sign: s.faqOpen === i ? '−' : '+', toggle: () => this.setState({ faqOpen: s.faqOpen === i ? -1 : i }) })),\n      form: s.form, on: { name: setF('name'), tel: setF('tel'), email: setF('email'), goal: setF('goal') },\n      thanks: t.thanks.replace('{n}', s.form.name), callback: t.callback.replace('{t}', s.form.tel),\n      submitted: s.submitted, notSubmitted: !s.submitted,\n      onSubmit: e => {\n        e.preventDefault();\n        const FORMSPREE = 'https://formspree.io/f/xdekjrvy';\n        fetch(FORMSPREE, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },\n          body: JSON.stringify({ nom: s.form.name, telephone: s.form.tel, email: s.form.email, _replyto: s.form.email, objectif: s.form.goal, langue: s.lang, _subject: 'Nouvelle demande PR Altitude — ' + s.form.name }) }).catch(() => {});\n        this.setState({ submitted: true });\n      },\n      reset: () => this.setState({ submitted: false, form: { name: '', tel: '', email: '', goal: '' } })\n    };\n  }\n}\nvar SEA = { fr: 'Plaine, basse altitude', en: 'Lowlands', es: 'Llanura, baja altitud', ca: 'Plana, baixa altitud' };\nvar ELITE = {\n  fr: { stats: [{\"v\":\"+3,6 %\",\"d\":\"Cyclisme : +3,6 % de puissance sur un contre-la-montre de 30 km chez des vététistes de compétition, après 4 semaines à dormir en hypoxie.\",\"src\":\"Czuba et al., 2018\"},{\"v\":\"+1,9 %\",\"d\":\"Course à pied : temps estimé sur 3 000 m chez des coureurs et triathlètes, après 25 nuits sous tente hypoxique.\",\"src\":\"Eur J Sport Sci, 2005\"},{\"v\":\"−15 %\",\"d\":\"Trail : perte de performance en montée à 2 500 m chez des traileurs non acclimatés, que la préparation vise à limiter.\",\"src\":\"Jaén-Carrillo et al., 2026\"}], eyebrow: 'Haut niveau', title: 'La préparation des athlètes professionnels.', p1: 'Cyclistes, traileurs, triathlètes, fondeurs ou alpinistes d’expédition : de nombreux athlètes professionnels et de haut niveau intègrent le sommeil en hypoxie à leur préparation.', p2: 'Des études sur la méthode « dormir en haut, s’entraîner en bas » ont montré des gains significatifs d’endurance et de performance chez les athlètes entraînés. PR Altitude rend cette préparation accessible chez vous.' },\n  en: { stats: [{\"v\":\"+3.6%\",\"d\":\"Cycling: +3.6% power output over a 30 km time trial in competitive mountain bikers, after 4 weeks sleeping in hypoxia.\",\"src\":\"Czuba et al., 2018\"},{\"v\":\"+1.9%\",\"d\":\"Running: estimated 3,000 m time in runners and triathletes, after 25 nights in a hypoxic tent.\",\"src\":\"Eur J Sport Sci, 2005\"},{\"v\":\"−15%\",\"d\":\"Trail: uphill performance loss at 2,500 m in non-acclimatised trail runners, which preparation aims to reduce.\",\"src\":\"Jaén-Carrillo et al., 2026\"}], eyebrow: 'Elite level', title: 'How professional athletes prepare.', p1: 'Cyclists, trail runners, triathletes, cross-country skiers and expedition mountaineers: many professional and elite athletes build sleeping in hypoxia into their preparation.', p2: 'Studies on the “sleep high, train low” method have shown significant gains in endurance and performance in trained athletes. PR Altitude brings this preparation to your home.' },\n  es: { stats: [{\"v\":\"+3,6 %\",\"d\":\"Ciclismo: +3,6 % de potencia en una contrarreloj de 30 km en ciclistas de montaña de competición, tras 4 semanas durmiendo en hipoxia.\",\"src\":\"Czuba et al., 2018\"},{\"v\":\"+1,9 %\",\"d\":\"Carrera: tiempo estimado en 3.000 m en corredores y triatletas, tras 25 noches en tienda hipóxica.\",\"src\":\"Eur J Sport Sci, 2005\"},{\"v\":\"−15 %\",\"d\":\"Trail: pérdida de rendimiento en subida a 2.500 m en corredores no aclimatados, que la preparación busca reducir.\",\"src\":\"Jaén-Carrillo et al., 2026\"}], eyebrow: 'Alto nivel', title: 'La preparación de los atletas profesionales.', p1: 'Ciclistas, corredores de trail, triatletas, esquiadores de fondo o alpinistas de expedición: muchos atletas profesionales y de alto nivel incorporan el sueño en hipoxia a su preparación.', p2: 'Los estudios sobre el método «dormir arriba, entrenar abajo» han mostrado mejoras significativas de resistencia y rendimiento en atletas entrenados. PR Altitude lleva esta preparación a tu casa.' },\n  ca: { stats: [{\"v\":\"+3,6 %\",\"d\":\"Ciclisme: +3,6 % de potència en una contrarellotge de 30 km en ciclistes de muntanya de competició, després de 4 setmanes dormint en hipòxia.\",\"src\":\"Czuba et al., 2018\"},{\"v\":\"+1,9 %\",\"d\":\"Cursa: temps estimat en 3.000 m en corredors i triatletes, després de 25 nits en tenda hipòxica.\",\"src\":\"Eur J Sport Sci, 2005\"},{\"v\":\"−15 %\",\"d\":\"Trail: pèrdua de rendiment en pujada a 2.500 m en corredors no aclimatats, que la preparació vol reduir.\",\"src\":\"Jaén-Carrillo et al., 2026\"}], eyebrow: 'Alt nivell', title: 'La preparació dels atletes professionals.', p1: 'Ciclistes, corredors de trail, triatletes, esquiadors de fons o alpinistes d’expedició: molts atletes professionals i d’alt nivell incorporen el son en hipòxia a la seva preparació.', p2: 'Els estudis sobre el mètode «dormir amunt, entrenar avall» han mostrat millores significatives de resistència i rendiment en atletes entrenats. PR Altitude porta aquesta preparació a casa teva.' }\n};\nvar DEP = { fr: 'Hors caution. Une caution est demandée à la location et restituée au retour du matériel, après vérification.', en: 'Deposit not included. A deposit is required when renting and refunded once the equipment is returned and checked.', es: 'Fianza no incluida. Se solicita una fianza al alquilar, que se devuelve tras la devolución y revisión del material.', ca: 'Fiança no inclosa. Es demana una fiança en llogar, que es retorna després de la devolució i revisió del material.' };\nvar NAV2 = { fr: { gear: 'Matériel', contact: 'Contact' }, en: { gear: 'Equipment', contact: 'Contact' }, es: { gear: 'Material', contact: 'Contacto' }, ca: { gear: 'Material', contact: 'Contacte' } };\nvar I18N = {\n  fr: {\n    navMethod: 'Méthode', navPricing: 'Tarifs', navQuote: 'Demander un devis', callCta: 'Être rappelé',\n    heroEyebrow: 'Location de tente hypoxique', heroTitle: 'Chaque nuit, un peu plus haut.',\n    heroText: 'Tente hypoxique et générateur livrés à domicile, pour s’acclimater à l’altitude sans quitter sa chambre.',\n    methodEyebrow: 'La méthode', methodTitle: 'Dormir en haut, s’entraîner en bas.',\n    methodText: 'Le générateur réduit la part d’oxygène de l’air envoyé dans la tente. L’organisme s’adapte pendant le sommeil, tandis que vos séances restent à pleine intensité au niveau de la mer.',\n    colAlt: 'Altitude', colO2: 'O₂ équiv.', colRef: 'Repère',\n    refs: ['Station de moyenne montagne', 'Début de protocole conseillé', 'Stage en altitude', 'Haute montagne', 'Sommet alpin'],\n    benefits: [\n      { t: 'Préparer la haute altitude', d: 'Arriver à un trek ou une expédition avec une partie de l’acclimatation déjà faite.' },\n      { t: 'Soutenir l’endurance', d: 'Une exposition régulière à l’hypoxie stimule la production naturelle de globules rouges.' },\n      { t: 'Sans changer votre quotidien', d: 'Aucun stage en montagne à organiser : l’exposition se fait pendant votre sommeil.' }],\n    stepsEyebrow: 'Déroulement', stepsTitle: 'De la demande au retour.',\n    steps: [\n      { n: '1', t: 'Devis', d: 'Vous nous indiquez votre objectif et vos dates, nous vous rappelons.' },\n      { n: '2', t: 'Envoi', d: 'Le matériel est expédié à votre domicile.' },\n      { n: '3', t: 'Acclimatation', d: 'Vous dormez sous tente en montant l’altitude par paliers.' },\n      { n: '4', t: 'Retour', d: 'Vous renvoyez le matériel dans son emballage d’origine.' }],\n    gearEyebrow: 'Le matériel', gearTitle: 'Tout arrive dans un seul colis.',\n    gear: [\n      { k: 'Tente', v: 'Tente de lit, montage sans outil.' },\n      { k: 'Générateur', v: 'Générateur hypoxique réglable, placé hors de la chambre.' },\n      { k: 'Oxymètre', v: 'Pour suivre votre saturation au réveil.' },\n      { k: 'Guide', v: 'Notice de montage et protocole de montée en altitude.' }],\n    pricingTitle: 'Simple et sans engagement de durée.',\n    plan3: 'Forfait 3 semaines', plan3Desc: 'Un bloc d’acclimatation complet · 60 € d’économie',\n    planWeek: 'À la semaine', planWeekDesc: 'Durée libre, selon votre calendrier',\n    quotesEyebrow: 'Ils ont dormi en altitude',\n    quotes: [\n      { t: 'Texte du témoignage client à ajouter.', a: 'Prénom N., trail — à compléter' },\n      { t: 'Texte du témoignage client à ajouter.', a: 'Prénom N., alpinisme — à compléter' },\n      { t: 'Texte du témoignage client à ajouter.', a: 'Prénom N., cyclisme — à compléter' }],\n    faqTitle: 'Questions fréquentes',\n    faq: [[\"Est-ce adapté à tout le monde ?\",\"L’hypoxie est déconseillée en cas de pathologie cardiaque ou respiratoire, d’anémie, d’hypertension non contrôlée et pendant la grossesse. Même en bonne santé, nous recommandons de consulter un médecin avant toute location, surtout si vous n’avez jamais séjourné en altitude. Pendant l’utilisation, maux de tête persistants, essoufflement inhabituel ou troubles du sommeil marqués sont des signaux pour redescendre d’un palier ou faire une pause.\"],\n      [\"Comment se passe l’envoi ?\",\"Le matériel est expédié par transporteur à votre domicile, dans un emballage conçu pour le retour. Vous recevez la tente, le générateur, les tuyaux, l’oxymètre et une notice de montage illustrée. Le montage prend environ une demi-heure, et nous restons joignables par téléphone si vous avez besoin d’aide pour l’installation ou le premier réglage.\"],\n      [\"Le générateur est-il bruyant ?\",\"Il fonctionne en continu, avec un bruit comparable à celui d’un petit compresseur ou d’un climatiseur d’appartement. Un tuyau de plusieurs mètres permet de le placer dans une pièce voisine ou un couloir, porte fermée, pour que la chambre reste calme. La plupart des utilisateurs s’y habituent dès les premières nuits.\"],\n      [\"À quelle altitude commencer ?\",\"En général autour de 1 500 à 2 000 m pour les premières nuits. On monte ensuite par paliers de quelques centaines de mètres, tous les deux ou trois jours, en s’appuyant sur ses sensations et sur la saturation mesurée au réveil avec l’oxymètre. Le protocole fourni avec le matériel détaille une progression type, que nous adaptons avec vous à votre objectif.\"],\n      [\"Combien de temps louer ?\",\"Trois semaines constituent un bloc d’acclimatation complet : le temps de monter progressivement puis de dormir plusieurs nuits à l’altitude visée. Pour préparer une expédition ou une course en altitude, l’idéal est de terminer la location peu de temps avant le départ. La location à la semaine permet d’allonger ou de raccourcir la période selon votre calendrier.\"]],\n    contactTitle: 'Parlons de votre prochain sommet.', contactText: 'Laissez vos coordonnées : nous vous rappelons pour établir un devis et fixer la date d’envoi.',\n    fName: 'Nom', fTel: 'Téléphone', fGoal: 'Objectif et dates souhaitées',\n    thanks: 'Merci {n}.', callback: 'Nous vous rappelons au {t} sous 24 h.', newReq: 'Nouvelle demande',\n    footer: 'Location de tentes hypoxiques'\n  },\n  en: {\n    navMethod: 'Method', navPricing: 'Pricing', navQuote: 'Get a quote', callCta: 'Request a call',\n    heroEyebrow: 'Hypoxic tent rental', heroTitle: 'Every night, a little higher.',\n    heroText: 'A hypoxic tent and generator delivered to your door, so you can acclimatise to altitude without leaving your bedroom.',\n    methodEyebrow: 'The method', methodTitle: 'Sleep high, train low.',\n    methodText: 'The generator lowers the share of oxygen in the air pumped into the tent. Your body adapts while you sleep, and your training sessions stay at full intensity at sea level.',\n    colAlt: 'Altitude', colO2: 'O₂ equiv.', colRef: 'Reference',\n    refs: ['Mid-mountain resort', 'Suggested starting point', 'Altitude training camp', 'High mountains', 'Alpine summit'],\n    benefits: [\n      { t: 'Prepare for high altitude', d: 'Arrive at a trek or expedition with part of your acclimatisation already done.' },\n      { t: 'Support endurance', d: 'Regular exposure to hypoxia stimulates natural red blood cell production.' },\n      { t: 'No change to your routine', d: 'No mountain camp to organise: the exposure happens while you sleep.' }],\n    stepsEyebrow: 'How it works', stepsTitle: 'From request to return.',\n    steps: [\n      { n: '1', t: 'Quote', d: 'Tell us your goal and dates, and we call you back.' },\n      { n: '2', t: 'Delivery', d: 'The equipment is shipped to your home.' },\n      { n: '3', t: 'Acclimatisation', d: 'You sleep in the tent, raising the altitude step by step.' },\n      { n: '4', t: 'Return', d: 'You send the equipment back in its original packaging.' }],\n    gearEyebrow: 'Equipment', gearTitle: 'Everything arrives in one parcel.',\n    gear: [\n      { k: 'Tent', v: 'Bed tent, tool-free assembly.' },\n      { k: 'Generator', v: 'Adjustable hypoxic generator, placed outside the bedroom.' },\n      { k: 'Oximeter', v: 'To track your saturation when you wake up.' },\n      { k: 'Guide', v: 'Assembly instructions and altitude progression protocol.' }],\n    pricingTitle: 'Simple, with no fixed commitment.',\n    plan3: '3-week package', plan3Desc: 'A complete acclimatisation block · save €60',\n    planWeek: 'Weekly', planWeekDesc: 'Flexible length, to fit your schedule',\n    quotesEyebrow: 'They slept at altitude',\n    quotes: [\n      { t: 'Customer testimonial to be added.', a: 'First name L., trail — to be completed' },\n      { t: 'Customer testimonial to be added.', a: 'First name L., mountaineering — to be completed' },\n      { t: 'Customer testimonial to be added.', a: 'First name L., cycling — to be completed' }],\n    faqTitle: 'Frequently asked questions',\n    faq: [[\"Is it suitable for everyone?\",\"Hypoxia is not recommended for people with heart or respiratory conditions, anaemia, uncontrolled high blood pressure, or during pregnancy. Even if you are in good health, we recommend seeing a doctor before renting, especially if you have never spent time at altitude. While using the tent, persistent headaches, unusual breathlessness or badly disturbed sleep are signs to drop down a step or take a break.\"],\n      [\"How is it delivered?\",\"The equipment is shipped by courier to your home, in packaging designed for the return trip. You receive the tent, generator, hoses, oximeter and illustrated assembly instructions. Setup takes about half an hour, and you can reach us by phone if you need help with installation or the first settings.\"],\n      [\"Is the generator noisy?\",\"It runs continuously, with a sound similar to a small compressor or a room air conditioner. A hose several metres long lets you place it in the next room or a hallway with the door closed, so the bedroom stays quiet. Most users get used to it within the first few nights.\"],\n      [\"What altitude should I start at?\",\"Usually around 1,500 to 2,000 m for the first nights. You then go up in steps of a few hundred metres every two or three days, guided by how you feel and by the saturation you measure with the oximeter when you wake up. The protocol supplied with the equipment sets out a typical progression, which we adjust with you to your goal.\"],\n      [\"How long should I rent?\",\"Three weeks make a complete acclimatisation block: enough time to climb gradually and then sleep several nights at your target altitude. To prepare for an expedition or a race at altitude, it is best to finish the rental shortly before you leave. Weekly rental lets you extend or shorten the period to fit your schedule.\"]],\n    contactTitle: 'Let’s talk about your next summit.', contactText: 'Leave your details and we will call you back to prepare a quote and set a shipping date.',\n    fName: 'Name', fTel: 'Phone', fGoal: 'Goal and preferred dates',\n    thanks: 'Thank you {n}.', callback: 'We will call you back at {t} within 24 hours.', newReq: 'New request',\n    footer: 'Hypoxic tent rental'\n  },\n  es: {\n    navMethod: 'Método', navPricing: 'Tarifas', navQuote: 'Pedir presupuesto', callCta: 'Solicitar llamada',\n    heroEyebrow: 'Alquiler de tienda hipóxica', heroTitle: 'Cada noche, un poco más alto.',\n    heroText: 'Tienda hipóxica y generador entregados a domicilio, para aclimatarse a la altitud sin salir de la habitación.',\n    methodEyebrow: 'El método', methodTitle: 'Dormir arriba, entrenar abajo.',\n    methodText: 'El generador reduce la proporción de oxígeno del aire que llega a la tienda. El organismo se adapta durante el sueño, mientras tus sesiones siguen a plena intensidad a nivel del mar.',\n    colAlt: 'Altitud', colO2: 'O₂ equiv.', colRef: 'Referencia',\n    refs: ['Estación de media montaña', 'Inicio de protocolo recomendado', 'Concentración en altura', 'Alta montaña', 'Cumbre alpina'],\n    benefits: [\n      { t: 'Preparar la alta montaña', d: 'Llegar a un trekking o una expedición con parte de la aclimatación ya hecha.' },\n      { t: 'Apoyar la resistencia', d: 'La exposición regular a la hipoxia estimula la producción natural de glóbulos rojos.' },\n      { t: 'Sin cambiar tu rutina', d: 'Ninguna concentración en montaña que organizar: la exposición se hace mientras duermes.' }],\n    stepsEyebrow: 'Cómo funciona', stepsTitle: 'De la solicitud a la devolución.',\n    steps: [\n      { n: '1', t: 'Presupuesto', d: 'Nos indicas tu objetivo y tus fechas, y te llamamos.' },\n      { n: '2', t: 'Envío', d: 'El material se envía a tu domicilio.' },\n      { n: '3', t: 'Aclimatación', d: 'Duermes en la tienda subiendo la altitud por etapas.' },\n      { n: '4', t: 'Devolución', d: 'Devuelves el material en su embalaje original.' }],\n    gearEyebrow: 'El material', gearTitle: 'Todo llega en un solo paquete.',\n    gear: [\n      { k: 'Tienda', v: 'Tienda de cama, montaje sin herramientas.' },\n      { k: 'Generador', v: 'Generador hipóxico regulable, colocado fuera de la habitación.' },\n      { k: 'Pulsioxímetro', v: 'Para seguir tu saturación al despertar.' },\n      { k: 'Guía', v: 'Instrucciones de montaje y protocolo de subida en altitud.' }],\n    pricingTitle: 'Sencillo y sin permanencia.',\n    plan3: 'Pack 3 semanas', plan3Desc: 'Un bloque de aclimatación completo · 60 € de ahorro',\n    planWeek: 'Por semana', planWeekDesc: 'Duración libre, según tu calendario',\n    quotesEyebrow: 'Durmieron en altitud',\n    quotes: [\n      { t: 'Testimonio de cliente por añadir.', a: 'Nombre A., trail — por completar' },\n      { t: 'Testimonio de cliente por añadir.', a: 'Nombre A., alpinismo — por completar' },\n      { t: 'Testimonio de cliente por añadir.', a: 'Nombre A., ciclismo — por completar' }],\n    faqTitle: 'Preguntas frecuentes',\n    faq: [[\"¿Es apto para todo el mundo?\",\"La hipoxia no se recomienda en caso de patología cardíaca o respiratoria, anemia, hipertensión no controlada ni durante el embarazo. Aunque estés en buena salud, te recomendamos consultar a un médico antes de alquilar, sobre todo si nunca has estado en altitud. Durante el uso, un dolor de cabeza persistente, una falta de aire inusual o un sueño muy alterado son señales para bajar una etapa o hacer una pausa.\"],\n      [\"¿Cómo es el envío?\",\"El material se envía por transportista a tu domicilio, en un embalaje pensado para la devolución. Recibes la tienda, el generador, los tubos, el pulsioxímetro y unas instrucciones de montaje ilustradas. El montaje lleva una media hora, y puedes llamarnos si necesitas ayuda con la instalación o el primer ajuste.\"],\n      [\"¿Hace ruido el generador?\",\"Funciona de forma continua, con un ruido parecido al de un pequeño compresor o un aire acondicionado doméstico. Un tubo de varios metros permite colocarlo en una habitación contigua o en un pasillo, con la puerta cerrada, para que el dormitorio siga tranquilo. La mayoría de los usuarios se acostumbra en las primeras noches.\"],\n      [\"¿A qué altitud empezar?\",\"Normalmente entre 1.500 y 2.000 m las primeras noches. Después se sube por etapas de unos cientos de metros cada dos o tres días, según tus sensaciones y la saturación medida al despertar con el pulsioxímetro. El protocolo incluido con el material detalla una progresión tipo, que adaptamos contigo a tu objetivo.\"],\n      [\"¿Cuánto tiempo alquilar?\",\"Tres semanas forman un bloque de aclimatación completo: el tiempo de subir poco a poco y dormir varias noches a la altitud objetivo. Para preparar una expedición o una carrera en altitud, lo ideal es terminar el alquiler poco antes de la salida. El alquiler semanal permite alargar o acortar el periodo según tu calendario.\"]],\n    contactTitle: 'Hablemos de tu próxima cumbre.', contactText: 'Déjanos tus datos: te llamamos para preparar un presupuesto y fijar la fecha de envío.',\n    fName: 'Nombre', fTel: 'Teléfono', fGoal: 'Objetivo y fechas deseadas',\n    thanks: 'Gracias {n}.', callback: 'Te llamamos al {t} en menos de 24 h.', newReq: 'Nueva solicitud',\n    footer: 'Alquiler de tiendas hipóxicas'\n  },\n  ca: {\n    navMethod: 'Mètode', navPricing: 'Tarifes', navQuote: 'Demanar pressupost', callCta: 'Sol·licitar trucada',\n    heroEyebrow: 'Lloguer de tenda hipòxica', heroTitle: 'Cada nit, una mica més amunt.',\n    heroText: 'Tenda hipòxica i generador lliurats a domicili, per aclimatar-se a l’altitud sense sortir de l’habitació.',\n    methodEyebrow: 'El mètode', methodTitle: 'Dormir amunt, entrenar avall.',\n    methodText: 'El generador redueix la proporció d’oxigen de l’aire que arriba a la tenda. L’organisme s’adapta durant el son, mentre les teves sessions continuen a plena intensitat a nivell del mar.',\n    colAlt: 'Altitud', colO2: 'O₂ equiv.', colRef: 'Referència',\n    refs: ['Estació de mitja muntanya', 'Inici de protocol recomanat', 'Estada en altitud', 'Alta muntanya', 'Cim alpí'],\n    benefits: [\n      { t: 'Preparar l’alta muntanya', d: 'Arribar a un trekking o una expedició amb part de l’aclimatació ja feta.' },\n      { t: 'Donar suport a la resistència', d: 'L’exposició regular a la hipòxia estimula la producció natural de glòbuls vermells.' },\n      { t: 'Sense canviar la teva rutina', d: 'Cap estada a la muntanya per organitzar: l’exposició es fa mentre dorms.' }],\n    stepsEyebrow: 'Com funciona', stepsTitle: 'De la sol·licitud al retorn.',\n    steps: [\n      { n: '1', t: 'Pressupost', d: 'Ens indiques el teu objectiu i les dates, i et truquem.' },\n      { n: '2', t: 'Enviament', d: 'El material s’envia al teu domicili.' },\n      { n: '3', t: 'Aclimatació', d: 'Dorms a la tenda pujant l’altitud per etapes.' },\n      { n: '4', t: 'Retorn', d: 'Retornes el material en el seu embalatge original.' }],\n    gearEyebrow: 'El material', gearTitle: 'Tot arriba en un sol paquet.',\n    gear: [\n      { k: 'Tenda', v: 'Tenda de llit, muntatge sense eines.' },\n      { k: 'Generador', v: 'Generador hipòxic regulable, col·locat fora de l’habitació.' },\n      { k: 'Pulsioxímetre', v: 'Per seguir la teva saturació en despertar.' },\n      { k: 'Guia', v: 'Instruccions de muntatge i protocol de pujada en altitud.' }],\n    pricingTitle: 'Senzill i sense permanència.',\n    plan3: 'Paquet 3 setmanes', plan3Desc: 'Un bloc d’aclimatació complet · 60 € d’estalvi',\n    planWeek: 'Per setmana', planWeekDesc: 'Durada lliure, segons el teu calendari',\n    quotesEyebrow: 'Van dormir en altitud',\n    quotes: [\n      { t: 'Testimoni de client per afegir.', a: 'Nom C., trail — per completar' },\n      { t: 'Testimoni de client per afegir.', a: 'Nom C., alpinisme — per completar' },\n      { t: 'Testimoni de client per afegir.', a: 'Nom C., ciclisme — per completar' }],\n    faqTitle: 'Preguntes freqüents',\n    faq: [[\"És apte per a tothom?\",\"La hipòxia no es recomana en cas de patologia cardíaca o respiratòria, anèmia, hipertensió no controlada ni durant l’embaràs. Encara que estiguis bé de salut, et recomanem consultar un metge abans de llogar, sobretot si mai no has estat en altitud. Durant l’ús, un mal de cap persistent, una manca d’aire inusual o un son molt alterat són senyals per baixar una etapa o fer una pausa.\"],\n      [\"Com és l’enviament?\",\"El material s’envia per transportista al teu domicili, en un embalatge pensat per al retorn. Reps la tenda, el generador, els tubs, el pulsioxímetre i unes instruccions de muntatge il·lustrades. El muntatge dura una mitja hora, i ens pots trucar si necessites ajuda amb la instal·lació o el primer ajust.\"],\n      [\"El generador fa soroll?\",\"Funciona de manera contínua, amb un soroll semblant al d’un petit compressor o d’un aire condicionat domèstic. Un tub de diversos metres permet col·locar-lo en una habitació del costat o en un passadís, amb la porta tancada, perquè el dormitori continuï tranquil. La majoria d’usuaris s’hi acostumen les primeres nits.\"],\n      [\"A quina altitud començar?\",\"Normalment entre 1.500 i 2.000 m les primeres nits. Després es puja per etapes d’uns centenars de metres cada dos o tres dies, segons les teves sensacions i la saturació mesurada en despertar amb el pulsioxímetre. El protocol inclòs amb el material detalla una progressió tipus, que adaptem amb tu al teu objectiu.\"],\n      [\"Quant de temps llogar?\",\"Tres setmanes formen un bloc d’aclimatació complet: el temps de pujar a poc a poc i dormir diverses nits a l’altitud objectiu. Per preparar una expedició o una cursa en altitud, l’ideal és acabar el lloguer poc abans de la sortida. El lloguer setmanal permet allargar o escurçar el període segons el teu calendari.\"]],\n    contactTitle: 'Parlem del teu proper cim.', contactText: 'Deixa’ns les teves dades: et truquem per preparar un pressupost i fixar la data d’enviament.',\n    fName: 'Nom', fTel: 'Telèfon', fGoal: 'Objectiu i dates desitjades',\n    thanks: 'Gràcies {n}.', callback: 'Et truquem al {t} en menys de 24 h.', newReq: 'Nova sol·licitud',\n    footer: 'Lloguer de tendes hipòxiques'\n  }\n};\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
