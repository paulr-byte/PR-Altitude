nherit;cursor:pointer\">{{ t.newReq }}<\u002Fbutton>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<footer style=\"max-width:1280px;margin:0 auto;padding:36px 32px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;font-size:13px;color:oklch(0.5 0.012 60)\">\n  <div style=\"display:flex;align-items:flex-start;gap:3px;color:oklch(0.22 0.012 60)\"><div style=\"font-size:30px;font-weight:700;letter-spacing:-0.05em;line-height:0.85;font-family:'Instrument Sans',sans-serif\">PR<\u002Fdiv><div style=\"display:flex;flex-direction:column;gap:3px;padding-top:2px\"><div style=\"font-size:10px;font-weight:500;line-height:1;font-family:'Instrument Sans',sans-serif\">altitude<\u002Fdiv><div style=\"width:100%;height:2px;background:oklch(0.42 0.07 210)\"><\u002Fdiv><\u002Fdiv><\u002Fdiv>\n  <div style=\"display:flex;align-items:center;gap:24px;flex-wrap:wrap\"><a href=\"https://instagram.com/pr.altitude\" target=\"_blank\" rel=\"noopener\" style=\"display:flex;align-items:center;gap:8px;color:oklch(0.22 0.012 60);text-decoration:none\"><svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"5\"><\u002Frect><circle cx=\"12\" cy=\"12\" r=\"4\"><\u002Fcircle><circle cx=\"17.5\" cy=\"6.5\" r=\"0.8\" fill=\"currentColor\" stroke=\"none\"><\u002Fcircle><\u002Fsvg>@pr.altitude<\u002Fa><div>{{ t.footer }} · © 2026<\u002Fdiv><\u002Fdiv>\n<\u002Ffooter>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;showIntro&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;}}\">\nclass Component extends DCLogic {\n  state = { alt: 2500, page: this.pageFromHash(), lang: localStorage.getItem('pra_lang') || 'fr', langOpen: false, faqOpen: 0, submitted: false, form: { name: '', tel: '', email: '', goal: '' } };\n  componentDidMount() { 